# Development — PostgreSQL (local)
DATABASE_URL="postgresql://postgres:root@localhost:5432/violette_kids?schema=public"
DATABASE_PROVIDER="postgresql"

# Production — MySQL (VPS)
# DATABASE_URL="mysql://USER:PASS@127.0.0.1:3306/violette_kids"
# DATABASE_PROVIDER="mysql"

# JWT (Admin auth)
JWT_SECRET="change-me-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
