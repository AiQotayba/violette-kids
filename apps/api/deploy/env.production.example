# Copy to apps/api/.env on the server (never commit real values).

NODE_ENV=production

# MySQL on VPS (create database in CloudPanel first)
DATABASE_URL="mysql://USER:PASS@127.0.0.1:3306/violette_kids"
DATABASE_PROVIDER=mysql

# JWT
JWT_SECRET="change-me-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# API
PORT=4600
